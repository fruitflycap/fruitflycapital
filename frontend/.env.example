# Eight is the current pilot target. Increase only after benchmarking the
# Brian2 server; 100 is a staged capacity target, not a realtime guarantee.
# Supported range is 1..100; this is a population-size experiment setting,
# not a claim that 100 full MaleCNS copies run at interactive speed.
VITE_SWARM_SIZE=8
# Render-only bodies per independent CNS agent. The primary body is included,
# so the default is 80 visible flies; followers do not add brains.
VITE_BODIES_PER_BRAIN=10

# Optional Python adapter endpoint.
VITE_BRAIN_WS_URL=ws://127.0.0.1:8765
VITE_BRAIN_UPDATE_HZ=2
# Set VITE_SWARM_SIZE and NEUROSWARM_SWARM_SIZE to 100 only after benchmarking.
# Followers are visual only and do not create 1% portfolio voting units.
